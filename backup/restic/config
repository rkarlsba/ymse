# vim:ft=sh

# This file is managed by Ansible and *will* be overwritten. If you want to change
# anything in here, add it to /usr/local/etc/restic-override

# Since this is in another file, we'll just export it all :D

# We need a good path - it's lost sometimes
export PATH=/bin:/usr/bin:/usr/local/bin:/sbin:/usr/sbin:/usr/local/sbin:/snap/bin

# Variables - see https://restic.readthedocs.io/en/latest/040_backup.html#environment-variables
export RESTIC_REPOSITORY="sftp:restic:restic-repo"
export RESTIC_PASSWORD_FILE="/usr/local/etc/restic-password.txt"

export RESTIC_LOG_DIR="/var/log/restic"
export RESTIC_SNAPSHOT_JSON="$RESTIC_LOG_DIR/snapshots.json"
# export RESTIC_LATEST_ID_TXT="$RESTIC_LOG_DIR/latest_snapshot.txt" # Not in use (yet)
# export RESTIC_BACKUP_LOG="$RESTIC_LOG_DIR/backup.jsonl" # Not in use (yet)

export RESTIC_EXCLUDE_FILE="/usr/local/etc/restic-excludes.txt"
export RESTIC_EXCLUDE=""
export RESTIC_VERBOSE="0"
export RESTIC_ONE_FILESYSTEM="0"
export RESTIC_PRE_EXEC_JOB="/usr/local/bin/restic-backup-pre-exec.sh"
export RESTIC_POST_EXEC_JOB="/usr/local/bin/restic-backup-post-exec.sh"
export RESTIC_BACKUP_DIRS="/"
export OS=$( uname -s )

# Backup rotation - see https://restic.readthedocs.io/en/stable/060_forget.html
export RESTIC_KEEP_WIITHIN='14d'
export RESTIC_KEEP_WEEKLY='5'
export RESTIC_KEEP_MONTHLY='3'
export RESTIC_KEEP_YEARLY='0'

export PROGNAME=restic-backup
export LOCKDIR=/var/lock
export LOCKFILE=$LOCKDIR/$PROGNAME.lock
export AUTOCLEANUP=1

