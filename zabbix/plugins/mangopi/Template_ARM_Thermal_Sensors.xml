<?xml version="1.0" encoding="UTF-8"?>
<zabbix_export>
  <version>7.0</version>

  <template_groups>
    <template_group>
      <uuid>c3b36f2e-0ce9-4faf-9c0c-2c07d79e55a2</uuid>
      <name>Templates/Hardware</name>
    </template_group>
  </template_groups>

  <templates>
    <template>
      <uuid>9de6f120-6be3-43ab-bb95-7900e9b7da9b</uuid>
      <template>Template ARM Thermal Sensors</template>
      <name>Template ARM Thermal Sensors</name>

      <groups>
        <group>
          <name>Templates/Hardware</name>
        </group>
      </groups>

      <items>
        <item>
          <uuid>7d7e71c4-7a8c-4821-af17-1cdde7aea32a</uuid>
          <name>Thermal zones JSON</name>
          <type>ZABBIX_AGENT</type>
          <key>thermal.json</key>
          <value_type>TEXT</value_type>
          <delay>30s</delay>
          <history>1d</history>
          <trends>0</trends>
          <preprocessing/>
        </item>
      </items>

      <discovery_rules>
        <discovery_rule>
          <uuid>0f7e997d-b603-4be4-8209-3d04297df034</uuid>
          <name>Thermal zone discovery</name>
          <key>thermal.lld</key>
          <type>ZABBIX_AGENT</type>
          <delay>300s</delay>

          <lld_steps>
            <lld_step>
              <type>JSONPATH</type>
              <parameter>$.data</parameter>
            </lld_step>
          </lld_steps>

          <item_prototypes>
            <item_prototype>
              <uuid>0ad58f43-5ea7-4a8c-b579-025904960996</uuid>
              <name>Temperature {#ITEMKEY}</name>
              <key>thermal[{#ITEMKEY}]</key>
              <type>DEPENDENT</type>
              <value_type>FLOAT</value_type>
              <units>°C</units>
              <delay>0s</delay>
              <history>3d</history>
              <trends>30d</trends>

              <master_item>
                <key>thermal.json</key>
              </master_item>

              <preprocessing>
                <step>
                  <type>JSONPATH</type>
                  <parameter>$.{#ITEMKEY}</parameter>
                </step>
              </preprocessing>
            </item_prototype>
          </item_prototypes>
        </discovery_rule>
      </discovery_rules>

      <macros/>
      <tags/>
    </template>
  </templates>

</zabbix_export>
