<?xml version="1.0" encoding="UTF-8"?>
<zabbix_export>
  <version>7.0</version>
  <groups>
    <group>
      <name>Templates/Hardware</name>
    </group>
  </groups>

  <templates>
    <template>
      <template>Template Linux Thermal Zones (MangoPi)</template>
      <name>Template Linux Thermal Zones (MangoPi)</name>
      <groups>
        <group>
          <name>Templates/Hardware</name>
        </group>
      </groups>

      <items/>
      <discovery_rules>
        <discovery_rule>
          <name>MangoPi Thermal Zone Discovery</name>
          <key>system.run[/usr/local/bin/mangopi_thermal_json.py --lld]</key>
          <type>0</type> <!-- Zabbix agent -->
          <delay>1m</delay>
          <lifetime>7d</lifetime>
          <enabled>1</enabled>
          <item_prototypes>
            <item_prototype>
              <name>Temperature {#ZONETYPE}</name>
              <key>system.run[/usr/local/bin/mangopi_thermal_json.py]</key>
              <value_type>0</value_type> <!-- numeric float -->
              <units>°C</units>
              <delay>30s</delay>
              <preprocessing>
                <step>
                  <type>21</type> <!-- JSONPATH -->
                  <params>$.{#ZONETYPE}</params>
                </step>
              </preprocessing>
            </item_prototype>
          </item_prototypes>

          <trigger_prototypes>
            <trigger_prototype>
              <name>{#ZONETYPE} temperature above 75°C</name>
              <expression>{Template Linux Thermal Zones (MangoPi):system.run[/usr/local/bin/mangopi_thermal_json.py].last()} > 75</expression>
              <priority>4</priority> <!-- High -->
              <description>Temperature for zone {#ZONETYPE} is above safe operating levels.</description>
            </trigger_prototype>
          </trigger_prototypes>

          <lld_macro_paths>
            <lld_macro_path>
              <lld_macro>{#ZONETYPE}</lld_macro>
              <path>$.data[*].{#ZONETYPE}</path>
            </lld_macro_path>
            <lld_macro_path>
              <lld_macro>{#ITEMKEY}</lld_macro>
              <path>$.data[*].{#ITEMKEY}</path>
            </lld_macro_path>
          </lld_macro_paths>

        </discovery_rule>
      </discovery_rules>
      <macros/>
    </template>
  </templates>
</zabbix_export>
